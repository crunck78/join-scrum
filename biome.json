{
	"$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		},
		"enabled": true
	},
	"files": {
		"includes": ["**", "!!**/dist"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab"
	},
	"html": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": false
		},
		"parser": {
			"interpolation": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"parser": {
			"allowComments": true
		}
	},
	"linter": {
		"enabled": true,
		"includes": ["**", "projects/**/*"],
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noStaticOnlyClass": "off",
						"useLiteralKeys": "off"
					},
					"style": {
						"useImportType": "off"
					},
					"suspicious": {
						"noAssignInExpressions": "off"
					}
				}
			}
		},
		{
			"includes": ["*.html"]
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
